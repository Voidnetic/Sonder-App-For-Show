# PostgreSQL connection string.
# Local install: postgresql://sonder:sonder@localhost:5432/sonder
# Or use a free hosted Postgres (Neon, Supabase, Railway, etc).
DATABASE_URL=postgresql://sonder:sonder@localhost:5432/sonder

# Change this to a long random string in production.
JWT_SECRET=change-this-in-production
JWT_EXPIRES_MINUTES=10080

# Comma separated list of allowed origins for CORS. Use * for any origin (dev only).
CORS_ORIGINS=*

PORT=8000

# Google sign-in: the *Web application* OAuth client ID from Google Cloud Console
# (the same one the app is built with as GOOGLE_SERVER_CLIENT_ID). Leave empty to turn Google sign-in off.
GOOGLE_CLIENT_IDS=

# Emails of the people who can review reports at /docs -> Admin. Comma separated.
ADMIN_EMAILS=

# Shown on /privacy, /terms and /delete-account. Use an address you check.
SUPPORT_EMAIL=
DEVELOPER_NAME=the Sonder team

# First start on an empty database creates the tables. SEED_DEMO_DATA=true also adds the demo users
# (password sonderpass123 for all of them), so only use it for testing, never for the real app.
AUTO_CREATE_SCHEMA=true
SEED_DEMO_DATA=false

# Cloudflare R2 photo storage (leave empty to keep photos in backend/uploads on this computer).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Firebase push notifications: the service account key JSON, base64 encoded. Leave empty for no push.
FIREBASE_SERVICE_ACCOUNT=
