# PostgreSQL connection string.
# Local install: postgresql://sonder:sonder@localhost:5432/sonder
# Or use a free hosted Postgres (Neon, Supabase, Railway, etc).
DATABASE_URL=postgresql://sonder:sonder@localhost:5432/sonder

# Change this to a long random string in production.
JWT_SECRET=change-this-in-production
JWT_EXPIRES_MINUTES=10080

# Comma separated list of allowed origins for CORS. Use * for any origin (dev only).
CORS_ORIGINS=*

PORT=8000
